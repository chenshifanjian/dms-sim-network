#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
eg25-mm-heal —— ModemManager / EG25-G 一键自愈

用途：`eg25-mms-send` 因为被 SIGKILL（插件超时、DMS 重启、关窗口…）而没能
      在 finally 里把 ModemManager 起回来时，由插件的看门狗调用本脚本兜底。

为什么不是「起一下 systemd 就完事」：
      硬杀时模块可能正处在 AT 命令中途，ModemManager 重新连上去会报
        state: failed / failed reason: unknown-capabilities
      这时必须清掉 QMI/PDP 残留上下文（eg25-unstick）才能回到 connected。

退出码：0 = 已恢复到可用；1 = 仍是坏状态（调用方可以再试或提示用户）
"""

import os
import subprocess
import sys
import time

# 与本脚本同目录找 eg25-unstick，换用户/换机器都能跑
HEAL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "eg25-unstick")
FLAG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "eg25-mm-stopped")


def sh(cmd: list[str], timeout: int = 90) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except Exception as e:  # noqa: BLE001
        return 1, str(e)


def mm_state() -> str:
    """返回 ModemManager 眼里的模块状态字符串（''=拿不到）。"""
    rc, out = sh(["mmcli", "-m", "any", "--output-keyvalue"], timeout=25)
    if rc != 0:
        return ""
    state = ""
    for line in out.splitlines():
        if "modem.generic.state" in line:
            state = line.split(":", 1)[-1].strip()
            # output-keyvalue 会带上 " (quoted)" 之类的后缀，只取第一个词
            state = state.split()[0] if state else ""
            break
    return state


def main() -> int:
    print("=== eg25-mm-heal 开始 ===")

    # ① 确保 ModemManager 在跑（免密 systemctl 规则）
    active = sh(["systemctl", "is-active", "ModemManager"])[1].strip()
    if active != "active":
        print(f"  ① ModemManager 当前 {active or '未知'} → 启动")
        sh(["sudo", "-n", "systemctl", "start", "ModemManager"], timeout=60)
    else:
        print("  ① ModemManager 已在运行")

    # ② 等它把模块认出来（最多 40 秒）
    state = ""
    for _ in range(20):
        time.sleep(2)
        state = mm_state()
        if state:
            break
    print(f"  ② 模块状态: {state or '拿不到 mmcli 输出'}")

    # ③ 状态良好 → 收工
    if state in ("connected", "registered", "enabling", "searching", "enabled"):
        print("  ✓ 已可用，无需进一步处理")
        _clear_flag()
        return 0

    # ④ 坏状态（failed / unknown / disabled）→ 清残留上下文
    print(f"  ③ 状态异常（{state or '未知'}）→ 跑 eg25-unstick 清残留 PDP 上下文"
          "（不带 --reset，自动路径不软复位模块）")
    rc, out = sh(["/usr/bin/env", "python3", HEAL], timeout=180)
    tail = "\n".join(out.strip().splitlines()[-6:])
    print("     " + tail.replace("\n", "\n     "))

    state = mm_state()
    print(f" ④ 自愈后状态: {state or '未知'}")
    if state in ("connected", "registered", "enabling", "enabled"):
        print("  ✓ 已恢复")
        _clear_flag()
        return 0

    print("  ✗ 仍异常。下一步（要人来点头）：")
    print("      eg25-unstick --reset    # 软复位模块 AT+CFUN=1,1，会断网约 20 秒")
    print("      mmcli -m any / journalctl -u ModemManager    # 先看日志")
    return 1


def _clear_flag() -> None:
    try:
        import os
        os.unlink(FLAG)
    except OSError:
        pass


if __name__ == "__main__":
    sys.exit(main())
